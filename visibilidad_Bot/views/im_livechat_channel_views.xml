<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="im_livechat_channel_view_form_inherit_visibility" model="ir.ui.view">
        <field name="name">im_livechat.channel.view.form.inherit.visibility</field>
        <field name="model">im_livechat.channel</field>
        <field name="inherit_id" ref="im_livechat.im_livechat_channel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='button_text']" position="after">
                <field name="bot_visibility" widget="radio"/>
            </xpath>
        </field>
    </record>
</odoo>
